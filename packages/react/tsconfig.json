{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["components/**/*", "hooks/**/*", "utils/**/*", "layouts/**/*", "tests/**/*", "vitest.config.mts"],
  "exclude": ["node_modules", "dist", "@examples"]
}
