{
  "name": "@egose/shadcn-theme",
  "version": "0.0.0-PLACEHOLDER",
  "description": "shadcn UI theme for React",
  "license": "PLACEHOLDER",
  "author": "PLACEHOLDER",
  "sideEffects": false,
  "private": true,
  "homepage": "https://shadcn-theme.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/egose/shadcn-theme",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/egose/shadcn-theme/issues"
  },
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "react",
    "tailwindcss",
    "ui",
    "components",
    "design-system"
  ],
  "files": [
    "components",
    "hooks",
    "utils",
    "layouts",
    "lib",
    "*.mjs",
    "*.js",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "exports": {
    "./components/ui/*": {
      "import": {
        "types": "./components/ui/*.d.mts",
        "default": "./components/ui/*.mjs"
      },
      "require": {
        "types": "./components/ui/*.d.ts",
        "default": "./components/ui/*.js"
      }
    },
    "./components/ui/extension/*": {
      "import": {
        "types": "./components/ui/extension/*.d.mts",
        "default": "./components/ui/extension/*.mjs"
      },
      "require": {
        "types": "./components/ui/extension/*.d.ts",
        "default": "./components/ui/extension/*.js"
      }
    },
    "./components/form/*": {
      "import": {
        "types": "./components/form/*.d.mts",
        "default": "./components/form/*.mjs"
      },
      "require": {
        "types": "./components/form/*.d.ts",
        "default": "./components/form/*.js"
      }
    },
    "./components/widgets/dialog-manager": {
      "import": {
        "types": "./components/widgets/dialog-manager/index.d.mts",
        "default": "./components/widgets/dialog-manager/index.mjs"
      },
      "require": {
        "types": "./components/widgets/dialog-manager/index.d.ts",
        "default": "./components/widgets/dialog-manager/index.js"
      }
    },
    "./components/widgets/*": {
      "import": {
        "types": "./components/widgets/*.d.mts",
        "default": "./components/widgets/*.mjs"
      },
      "require": {
        "types": "./components/widgets/*.d.ts",
        "default": "./components/widgets/*.js"
      }
    },
    "./components/widgets/dialog-manager/*": {
      "import": {
        "types": "./components/widgets/dialog-manager/*.d.mts",
        "default": "./components/widgets/dialog-manager/*.mjs"
      },
      "require": {
        "types": "./components/widgets/dialog-manager/*.d.ts",
        "default": "./components/widgets/dialog-manager/*.js"
      }
    },
    "./hooks/*": {
      "import": {
        "types": "./hooks/*.d.mts",
        "default": "./hooks/*.mjs"
      },
      "require": {
        "types": "./hooks/*.d.ts",
        "default": "./hooks/*.js"
      }
    },
    "./utils/*": {
      "import": {
        "types": "./utils/*.d.mts",
        "default": "./utils/*.mjs"
      },
      "require": {
        "types": "./utils/*.d.ts",
        "default": "./utils/*.js"
      }
    },
    "./layouts/simple": {
      "import": {
        "types": "./layouts/simple/index.d.mts",
        "default": "./layouts/simple/index.mjs"
      },
      "require": {
        "types": "./layouts/simple/index.d.ts",
        "default": "./layouts/simple/index.js"
      }
    },
    "./layouts/simple/*": {
      "import": {
        "types": "./layouts/simple/*.d.mts",
        "default": "./layouts/simple/*.mjs"
      },
      "require": {
        "types": "./layouts/simple/*.d.ts",
        "default": "./layouts/simple/*.js"
      }
    },
    "./layouts/sidebar1": {
      "import": {
        "types": "./layouts/sidebar1/index.d.mts",
        "default": "./layouts/sidebar1/index.mjs"
      },
      "require": {
        "types": "./layouts/sidebar1/index.d.ts",
        "default": "./layouts/sidebar1/index.js"
      }
    },
    "./layouts/sidebar1/*": {
      "import": {
        "types": "./layouts/sidebar1/*.d.mts",
        "default": "./layouts/sidebar1/*.mjs"
      },
      "require": {
        "types": "./layouts/sidebar1/*.d.ts",
        "default": "./layouts/sidebar1/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:package": "pnpm test:package-validator && pnpm prepare:package && pnpm validate:package",
    "test:client-boundaries": "node --test scripts/prepend-use-client.test.mjs && node scripts/validate-client-boundaries.mjs",
    "test:rsc": "node scripts/validate-rsc.mjs",
    "pack:package": "node scripts/pack-package.mjs",
    "prepare:consumer": "node scripts/prepare-isolated-consumer.mjs",
    "test:consumer": "pnpm --dir .isolated-consumer test",
    "build:consumer": "pnpm --dir .isolated-consumer build",
    "bundle": "tsup",
    "postbundle": "node prepend-use-client.mjs",
    "prepare:package": "cd ../.. && node scripts/publish.mjs --context react --version 0.0.0-test.0 --prepare-only",
    "validate:package": "node scripts/validate-package.mjs dist",
    "test:package-validator": "node --test scripts/validate-package.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.5.2",
    "input-otp": "^1.4.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.4",
    "radix-ui": "^1.6.1",
    "react-day-picker": "10.0.1",
    "react-resizable-panels": "^4.12.1",
    "tailwind-merge": "^3.6.0",
    "valtio": "^2.3.2",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.0.1",
    "esbuild": "^0.28.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.3.0",
    "jsdom": "^28.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
